{% assign product = closest.product %}

{% if product != blank %}
  <div class="product-page-badges" {{ block.shopify_attributes }}>
    {% render 'product-card-badges', product: product, inline: true %}
  </div>
{% endif %}

{% render 'product-badges-styles' %}

{% stylesheet %}
  .product-page-badges {
    width: 100%;
  }

  .product-page-badges .product-badges__badge {
    box-shadow: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product badges",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "Product badges",
      "category": "Product"
    }
  ]
}
{% endschema %}
