<section
  class="why-aila"
  style="
    --why-background: {{ section.settings.background_color }};
    --why-text: {{ section.settings.text_color }};
    --why-muted: {{ section.settings.muted_text_color }};
    --why-accent: {{ section.settings.accent_color }};
    --why-radius: {{ section.settings.image_radius }}px;
    --why-padding-top-setting: {{ section.settings.padding_top }}px;
    --why-padding-bottom-setting: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="why-aila__inner why-aila__inner--image-{{ section.settings.image_position }}">
    <div class="why-aila__copy">
      {% if section.settings.heading != blank %}
        <h2 class="why-aila__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <div class="why-aila__features">
        {% for block in section.blocks %}
          <article class="why-aila__feature" {{ block.shopify_attributes }}>
            <div class="why-aila__feature-heading">
              <span class="why-aila__icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'heart' %}
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M16 27S4 20 4 11.7C4 7.9 6.7 5 10.2 5c2.5 0 4.6 1.4 5.8 3.4C17.2 6.4 19.3 5 21.8 5 25.3 5 28 7.9 28 11.7 28 20 16 27 16 27Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                      <path d="M25 22v6m-3-3h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                  {% when 'tag' %}
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M4 15 15 4h10l3 3v10L17 28 4 15Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                      <circle cx="21.5" cy="10.5" r="1.6" fill="currentColor"/>
                    </svg>
                  {% when 'shop' %}
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M5 13h22l-2-7H7l-2 7Zm2 0v13h18V13M11 26v-7h10v7" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                      <path d="M4 13c0 2 1.4 3 3 3s3-1 3-3c0 2 1.4 3 3 3s3-1 3-3c0 2 1.4 3 3 3s3-1 3-3c0 2 1.4 3 3 3s3-1 3-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    </svg>
                  {% when 'truck' %}
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M3 7h17v16H3V7Zm17 6h5l4 5v5h-9V13ZM8 27a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm16 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                    </svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M16 3 27 7v8c0 7-4.6 11.6-11 14C9.6 26.6 5 22 5 15V7l11-4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                      <path d="m11 16 3 3 7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% when 'sparkle' %}
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M16 2c.6 8.3 4.7 12.4 13 13-8.3.6-12.4 4.7-13 13-.6-8.3-4.7-12.4-13-13 8.3-.6 12.4-4.7 13-13Z" stroke="currentColor" stroke-width="1.7"/>
                    </svg>
                {% endcase %}
              </span>

              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading | escape }}</h3>
              {% endif %}
            </div>

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text | escape }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>

    <div
      class="why-aila__media{% if section.settings.secondary_image != blank %} why-aila__media--two{% endif %}"
      aria-label="{{ section.settings.heading | escape }}"
    >
      {% if section.settings.image != blank %}
        <div class="why-aila__image-wrap why-aila__image-wrap--primary">
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              widths: '500, 750, 1100, 1500, 1800',
              sizes: '(max-width: 989px) calc(100vw - 32px), 34vw',
              loading: 'lazy',
              class: 'why-aila__image'
          }}
        </div>
      {% else %}
        <div class="why-aila__placeholder why-aila__image-wrap--primary" aria-hidden="true">
          <span class="why-aila__placeholder-glow"></span>
          <span class="why-aila__placeholder-shelf"></span>
          <span class="why-aila__placeholder-bottle why-aila__placeholder-bottle--one"></span>
          <span class="why-aila__placeholder-bottle why-aila__placeholder-bottle--two"></span>
          <span class="why-aila__placeholder-bottle why-aila__placeholder-bottle--three"></span>
        </div>
      {% endif %}

      {% if section.settings.secondary_image != blank %}
        <div class="why-aila__image-wrap why-aila__image-wrap--secondary">
          {{
            section.settings.secondary_image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 900, 1200, 1400',
              sizes: '(max-width: 989px) calc(50vw - 20px), 34vw',
              loading: 'lazy',
              class: 'why-aila__image'
          }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .why-aila {
    padding-block: var(--why-padding-top-setting) var(--why-padding-bottom-setting);
    background: var(--why-background);
    color: var(--why-text);
  }

  .why-aila__inner {
    display: grid;
    width: min(100% - 2rem, 1420px);
    margin-inline: auto;
    grid-template-columns: minmax(0, 1.8fr) minmax(280px, 0.72fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: stretch;
  }

  .why-aila__inner--image-left .why-aila__copy {
    order: 2;
  }

  .why-aila__inner--image-left .why-aila__media {
    order: 1;
  }

  .why-aila__copy {
    padding-block: clamp(1rem, 3vw, 3.5rem);
  }

  .why-aila__heading {
    margin: 0 0 clamp(3rem, 6vw, 6.5rem);
    color: inherit;
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1;
    text-wrap: balance;
  }

  .why-aila__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 5vw, 5.5rem) clamp(2rem, 5vw, 5rem);
  }

  .why-aila__feature-heading {
    display: flex;
    min-height: 42px;
    align-items: center;
    gap: 1rem;
  }

  .why-aila__icon {
    display: inline-flex;
    width: 38px;
    flex: 0 0 38px;
    color: var(--why-accent);
  }

  .why-aila__icon svg {
    width: 100%;
    height: auto;
  }

  .why-aila__feature h3 {
    margin: 0;
    color: inherit;
    font-size: clamp(1rem, 1.4vw, 1.35rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .why-aila__feature p {
    margin: 1rem 0 0;
    color: var(--why-muted);
    font-size: clamp(0.9rem, 1.2vw, 1.1rem);
    line-height: 1.55;
    letter-spacing: 0.02em;
    text-wrap: pretty;
  }

  .why-aila__media {
    display: grid;
    min-height: 560px;
    overflow: hidden;
    border-radius: var(--why-radius);
    background: #f3c8bc;
  }

  .why-aila__media--two {
    min-height: 680px;
    overflow: visible;
    grid-template-rows: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 1rem;
    border-radius: 0;
    background: transparent;
  }

  .why-aila__image-wrap,
  .why-aila__placeholder {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--why-radius);
  }

  .why-aila__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .why-aila__placeholder {
    isolation: isolate;
    min-height: 560px;
    background:
      radial-gradient(circle at 50% 4%, rgb(255 255 255 / 0.9) 0 9%, transparent 10%),
      linear-gradient(145deg, #efb2a1, #f5d5ca 55%, #dfa28f);
  }

  .why-aila__placeholder-glow {
    position: absolute;
    inset: 8% 9% 22%;
    border: 2px solid rgb(255 255 255 / 0.42);
    border-radius: 36px 36px 20px 20px;
    box-shadow:
      inset 0 0 30px rgb(255 255 255 / 0.32),
      0 0 24px rgb(255 244 237 / 0.25);
  }

  .why-aila__placeholder-shelf {
    position: absolute;
    right: 7%;
    bottom: 9%;
    left: 7%;
    height: 28%;
    border-radius: 45% 45% 16px 16px;
    background: linear-gradient(180deg, #f8ddd4, #d88f7c);
    box-shadow: 0 28px 30px rgb(116 52 38 / 0.18);
  }

  .why-aila__placeholder-bottle {
    position: absolute;
    z-index: 2;
    bottom: 30%;
    width: 14%;
    height: 24%;
    border: 2px solid rgb(111 58 47 / 0.32);
    border-radius: 14px 14px 10px 10px;
    background: rgb(255 248 239 / 0.72);
    box-shadow: inset 0 0 18px rgb(255 255 255 / 0.72);
  }

  .why-aila__placeholder-bottle::before {
    position: absolute;
    bottom: 100%;
    left: 30%;
    width: 40%;
    height: 20%;
    border-radius: 4px 4px 0 0;
    background: #8f665d;
    content: '';
  }

  .why-aila__placeholder-bottle--one {
    left: 19%;
  }

  .why-aila__placeholder-bottle--two {
    left: 43%;
    width: 16%;
    height: 30%;
  }

  .why-aila__placeholder-bottle--three {
    right: 18%;
    height: 20%;
  }

  @media screen and (max-width: 989px) {
    .why-aila__inner {
      grid-template-columns: 1fr;
    }

    .why-aila__copy,
    .why-aila__inner--image-left .why-aila__copy {
      order: 1;
      padding-block: 0;
    }

    .why-aila__media,
    .why-aila__inner--image-left .why-aila__media {
      order: 2;
      min-height: 520px;
      aspect-ratio: 4 / 3;
    }

    .why-aila__media--two {
      min-height: auto;
      aspect-ratio: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: minmax(360px, 55vw);
    }

    .why-aila__placeholder {
      min-height: 520px;
    }
  }

  @media screen and (max-width: 749px) {
    .why-aila {
      padding-block:
        min(var(--why-padding-top-setting), 56px)
        min(var(--why-padding-bottom-setting), 56px);
    }

    .why-aila__inner {
      width: min(100% - 1.25rem, 1420px);
      gap: 2.5rem;
    }

    .why-aila__heading {
      margin-bottom: 2.5rem;
    }

    .why-aila__features {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .why-aila__media {
      min-height: 440px;
      aspect-ratio: 4 / 5;
    }

    .why-aila__media--two {
      min-height: auto;
      aspect-ratio: auto;
      grid-template-columns: 1fr;
      grid-template-rows: repeat(2, minmax(380px, 105vw));
    }

    .why-aila__placeholder {
      min-height: 440px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Aila Fragrance",
  "tag": "div",
  "class": "section-wrapper seoul-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Aila Fragrance?"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Second image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fffdf9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2a2422"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Body text",
      "default": "#4f4744"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icons",
      "default": "#2a2422"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "tag",
              "label": "Tag"
            },
            {
              "value": "shop",
              "label": "Shop"
            },
            {
              "value": "truck",
              "label": "Delivery truck"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Carefully selected"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A thoughtful fragrance edit, chosen for quality and character."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Aila Fragrance",
      "category": "Text",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "heading": "Happy fragrance lovers",
            "text": "Loved by shoppers looking for memorable scents at approachable prices."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "tag",
            "heading": "Curated fragrances",
            "text": "A carefully selected range spanning everyday favourites and rare finds."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "shop",
            "heading": "Discover more brands",
            "text": "Explore distinctive fragrance houses and familiar names in one place."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "truck",
            "heading": "Reliable shipping",
            "text": "Orders are packed with care and sent using automatically calculated rates."
          }
        }
      ]
    }
  ]
}
{% endschema %}
