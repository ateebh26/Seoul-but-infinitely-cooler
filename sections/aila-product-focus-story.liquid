<script
  src="{{ 'aila-product-focus-story.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign story_video = section.settings.video
  assign story_image = section.settings.image
%}

<aila-product-focus-story
  class="aila-focus-story"
  data-zoom-amount="{{ section.settings.zoom_amount }}"
  data-final-media-width="{{ section.settings.final_media_width }}"
  style="
    --story-scroll-length: {{ section.settings.scroll_length }}svh;
    --story-final-media-width: {{ section.settings.final_media_width }}%;
    --story-media-x: {{ section.settings.media_position_x }}%;
    --story-media-y: {{ section.settings.media_position_y }}%;
    --story-background: {{ section.settings.background_color }};
    --story-text: {{ section.settings.text_color }};
    --story-muted: {{ section.settings.muted_text_color }};
    --story-accent: {{ section.settings.accent_color }};
    --story-card-background: {{ section.settings.card_background_color }};
    --story-media-radius: {{ section.settings.media_radius }}px;
  "
>
  <div class="aila-focus-story__scroll">
    <div class="aila-focus-story__stage" data-story-stage>
      <div class="aila-focus-story__media-frame">
        {% if story_video != blank %}
          {{
            story_video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata',
              class: 'aila-focus-story__video'
          }}
        {% elsif story_image != blank %}
          {{
            story_image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 2000, 2400',
              sizes: '100vw',
              loading: 'lazy',
              class: 'aila-focus-story__image'
          }}
        {% else %}
          <div class="aila-focus-story__placeholder" aria-hidden="true">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="aila-focus-story__media-overlay"></div>
      </div>

      <div class="aila-focus-story__hero-copy" data-story-hero-copy>
        {% if section.settings.eyebrow != blank %}
          <p class="aila-focus-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.hero_heading != blank %}
          <h2 class="aila-focus-story__hero-heading">{{ section.settings.hero_heading }}</h2>
        {% endif %}

        {% if section.settings.hero_text != blank %}
          <div class="aila-focus-story__hero-text rte">{{ section.settings.hero_text }}</div>
        {% endif %}

        <span class="aila-focus-story__scroll-cue" aria-hidden="true">
          <span></span>
          Scroll to explore
        </span>
      </div>

      <div class="aila-focus-story__product-panel" data-story-product-panel>
        <header class="aila-focus-story__panel-header">
          {% if section.settings.panel_eyebrow != blank %}
            <p class="aila-focus-story__panel-eyebrow">{{ section.settings.panel_eyebrow | escape }}</p>
          {% endif %}

          {% if section.settings.panel_heading != blank %}
            <h2>{{ section.settings.panel_heading | escape }}</h2>
          {% endif %}

          {% if section.settings.panel_text != blank %}
            <p>{{ section.settings.panel_text | escape }}</p>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a
              class="aila-focus-story__panel-link"
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_label | escape }}
              <span aria-hidden="true">↗</span>
            </a>
          {% endif %}
        </header>

        <div class="aila-focus-story__products" aria-label="{{ section.settings.panel_heading | default: 'Featured products' | escape }}">
          {% for block in section.blocks %}
            {% liquid
              assign featured_product = block.settings.product
              assign product_image = block.settings.image

              if product_image == blank and featured_product != blank
                assign product_image = featured_product.featured_image
              endif

              assign product_label = block.settings.label
              if product_label == blank and featured_product != blank
                assign product_label = featured_product.type
              endif
              if product_label == blank
                assign product_label = 'Featured fragrance'
              endif
            %}

            <article
              class="aila-focus-story__product-card"
              data-story-product-card
              {{ block.shopify_attributes }}
            >
              {% if featured_product != blank %}
                <a class="aila-focus-story__product-link" href="{{ featured_product.url }}">
              {% else %}
                <div class="aila-focus-story__product-link">
              {% endif %}

                <div class="aila-focus-story__product-media">
                  {% if product_image != blank %}
                    {{
                      product_image
                      | image_url: width: 1000
                      | image_tag:
                        widths: '280, 420, 640, 800, 1000',
                        sizes: '(min-width: 990px) 22vw, 76vw',
                        loading: 'lazy',
                        class: 'aila-focus-story__product-image'
                    }}
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'aila-focus-story__product-placeholder' }}
                  {% endif %}

                  {% if block.settings.badge != blank %}
                    <span class="aila-focus-story__badge">{{ block.settings.badge | escape }}</span>
                  {% endif %}

                  <span class="aila-focus-story__product-arrow" aria-hidden="true">↗</span>
                </div>

                <div class="aila-focus-story__product-details">
                  <span class="aila-focus-story__product-label">{{ product_label | escape }}</span>

                  {% if featured_product != blank %}
                    <h3>{{ featured_product.title | escape }}</h3>
                    <p class="aila-focus-story__price">
                      {% if featured_product.price_varies %}From {% endif %}
                      {{ featured_product.price_min | money_with_currency }}
                    </p>
                  {% else %}
                    <h3>Choose a product</h3>
                    <p class="aila-focus-story__price">Product details appear automatically</p>
                  {% endif %}
                </div>

              {% if featured_product != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>

      <div class="aila-focus-story__progress" aria-hidden="true">
        <span></span>
      </div>
    </div>
  </div>
</aila-product-focus-story>

{% stylesheet %}
  .aila-focus-story {
    --story-media-right: calc(98% - var(--story-final-media-width));
    --story-media-scale: 1.18;
    --story-hero-opacity: 0;
    --story-hero-shift: -26px;
    --story-panel-opacity: 1;
    --story-panel-shift: 0px;
    display: block;
    background: var(--story-background);
    color: var(--story-text);
  }

  .aila-focus-story__scroll {
    position: relative;
    min-height: 100svh;
  }

  .aila-focus-story[data-animated] .aila-focus-story__scroll {
    height: var(--story-scroll-length);
  }

  .aila-focus-story__stage {
    position: relative;
    min-height: max(760px, 100svh);
    overflow: hidden;
    isolation: isolate;
    background: var(--story-background);
  }

  .aila-focus-story[data-animated] .aila-focus-story__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
  }

  .aila-focus-story__media-frame {
    position: absolute;
    z-index: 1;
    top: 2.5%;
    right: var(--story-media-right);
    bottom: 2.5%;
    left: 2%;
    overflow: hidden;
    border-radius: var(--story-media-radius);
    background: color-mix(in srgb, var(--story-accent), var(--story-background) 68%);
    box-shadow: 0 24px 70px rgb(56 37 35 / 10%);
    will-change: right;
  }

  .aila-focus-story__video,
  .aila-focus-story__image,
  .aila-focus-story__placeholder,
  .aila-focus-story__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .aila-focus-story__video,
  .aila-focus-story__image,
  .aila-focus-story__placeholder svg {
    object-fit: cover;
    object-position: var(--story-media-x) var(--story-media-y);
    transform: scale(var(--story-media-scale));
    transform-origin: var(--story-media-x) var(--story-media-y);
    will-change: transform;
  }

  .aila-focus-story__placeholder svg {
    background: #eadbd6;
  }

  .aila-focus-story__media-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(20 15 14 / 5%), rgb(20 15 14 / 34%)),
      linear-gradient(90deg, rgb(20 15 14 / 18%), transparent 65%);
    pointer-events: none;
  }

  .aila-focus-story__hero-copy {
    position: absolute;
    z-index: 2;
    right: 8%;
    bottom: clamp(5rem, 11vh, 8rem);
    left: 8%;
    display: flex;
    align-items: center;
    flex-direction: column;
    color: #fffdf9;
    opacity: var(--story-hero-opacity);
    text-align: center;
    text-shadow: 0 2px 22px rgb(21 13 12 / 24%);
    transform: translateY(var(--story-hero-shift));
    will-change: opacity, transform;
  }

  .aila-focus-story__eyebrow,
  .aila-focus-story__panel-eyebrow {
    margin: 0 0 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .aila-focus-story__eyebrow {
    padding: 0.5rem 0.78rem;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .aila-focus-story__hero-heading {
    max-width: 18ch;
    margin: 0;
    color: inherit;
    font-size: clamp(3rem, 6vw, 6.8rem);
    letter-spacing: -0.055em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .aila-focus-story__hero-heading em {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
  }

  .aila-focus-story__hero-text {
    max-width: 44rem;
    margin-top: 1.25rem;
    font-size: clamp(0.9rem, 1.2vw, 1.1rem);
    line-height: 1.55;
  }

  .aila-focus-story__scroll-cue {
    display: inline-flex;
    margin-top: 1.6rem;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .aila-focus-story__scroll-cue span {
    width: 34px;
    height: 1px;
    background: currentColor;
  }

  .aila-focus-story__product-panel {
    position: absolute;
    z-index: 3;
    top: 0;
    right: 2%;
    bottom: 0;
    left: calc(4% + var(--story-final-media-width));
    display: flex;
    padding-block: clamp(2rem, 5vh, 4.5rem);
    justify-content: center;
    flex-direction: column;
    opacity: var(--story-panel-opacity);
    transform: translateX(var(--story-panel-shift));
    will-change: opacity, transform;
  }

  .aila-focus-story__panel-header {
    position: relative;
    padding-right: clamp(4.5rem, 8vw, 8rem);
  }

  .aila-focus-story__panel-eyebrow {
    color: var(--story-muted);
  }

  .aila-focus-story__panel-header h2 {
    max-width: 14ch;
    margin: 0;
    color: inherit;
    font-size: clamp(2rem, 3vw, 3.6rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .aila-focus-story__panel-header > p:not(.aila-focus-story__panel-eyebrow) {
    max-width: 48ch;
    margin: 1rem 0 0;
    color: var(--story-muted);
    font-size: clamp(0.8rem, 0.9vw, 0.98rem);
    line-height: 1.55;
  }

  .aila-focus-story__panel-link {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    min-height: 42px;
    padding-inline: 1rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .aila-focus-story__panel-link:hover {
    background: var(--story-text);
    color: var(--story-background);
    transform: translateY(-2px);
  }

  .aila-focus-story__products {
    display: grid;
    margin-top: clamp(1.25rem, 2.7vh, 2.4rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.2vw, 1.25rem);
  }

  .aila-focus-story__product-card {
    min-width: 0;
    opacity: var(--story-card-reveal, 1);
    transform: translateY(var(--story-card-shift, 0));
    will-change: opacity, transform;
  }

  .aila-focus-story__product-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .aila-focus-story__product-media {
    position: relative;
    height: clamp(130px, 19svh, 220px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--story-text), transparent 88%);
    border-radius: clamp(16px, 1.6vw, 24px);
    background: var(--story-card-background);
  }

  .aila-focus-story__product-image,
  .aila-focus-story__product-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .aila-focus-story__product-link:hover .aila-focus-story__product-image,
  .aila-focus-story__product-link:hover .aila-focus-story__product-placeholder {
    transform: scale(1.035);
  }

  .aila-focus-story__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.42rem 0.62rem;
    border-radius: 999px;
    background: var(--story-accent);
    color: var(--story-text);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .aila-focus-story__product-arrow {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    place-items: center;
    background: rgb(255 253 249 / 88%);
    color: #2a2422;
    font-size: 0.8rem;
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .aila-focus-story__product-link:hover .aila-focus-story__product-arrow,
  .aila-focus-story__product-link:focus-visible .aila-focus-story__product-arrow {
    opacity: 1;
    transform: translateY(0);
  }

  .aila-focus-story__product-details {
    padding: 0.72rem 0.2rem 0;
  }

  .aila-focus-story__product-label {
    display: block;
    color: var(--story-muted);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .aila-focus-story__product-details h3 {
    margin: 0.25rem 0 0;
    color: inherit;
    font-size: clamp(0.85rem, 1.05vw, 1.08rem);
    line-height: 1.2;
    text-wrap: pretty;
  }

  .aila-focus-story__price {
    margin: 0.32rem 0 0;
    color: var(--story-muted);
    font-size: 0.74rem;
    line-height: 1.3;
  }

  .aila-focus-story__progress {
    position: absolute;
    z-index: 4;
    right: 2%;
    bottom: 1.1rem;
    left: calc(4% + var(--story-final-media-width));
    height: 2px;
    overflow: hidden;
    background: color-mix(in srgb, var(--story-text), transparent 88%);
    opacity: var(--story-panel-opacity);
  }

  .aila-focus-story__progress span {
    display: block;
    width: calc(var(--story-progress, 1) * 100%);
    height: 100%;
    background: var(--story-accent);
    transform-origin: left;
  }

  .aila-focus-story__panel-link:focus-visible,
  .aila-focus-story__product-link:focus-visible {
    outline: 2px solid var(--story-text);
    outline-offset: 4px;
  }

  @media screen and (max-width: 1199px) and (min-width: 990px) {
    .aila-focus-story__panel-header {
      padding-right: 0;
    }

    .aila-focus-story__panel-link {
      position: static;
      width: fit-content;
      margin-top: 1rem;
    }

    .aila-focus-story__product-media {
      height: clamp(120px, 17svh, 190px);
    }
  }

  @media screen and (max-width: 989px) {
    .aila-focus-story {
      --story-media-scale: 1;
    }

    .aila-focus-story__scroll {
      min-height: 0;
    }

    .aila-focus-story__stage {
      min-height: 0;
      padding: 0.75rem 0.75rem 0;
      overflow: visible;
    }

    .aila-focus-story__media-frame {
      position: relative;
      inset: auto;
      height: min(76svh, 720px);
      min-height: 540px;
      border-radius: min(var(--story-media-radius), 28px);
    }

    .aila-focus-story__hero-copy {
      z-index: 2;
      right: 2.25rem;
      bottom: 3.5rem;
      left: 2.25rem;
      opacity: 1;
      transform: none;
    }

    .aila-focus-story__hero-heading {
      font-size: clamp(2.8rem, 10vw, 5.5rem);
    }

    .aila-focus-story__scroll-cue {
      display: none;
    }

    .aila-focus-story__product-panel {
      position: relative;
      inset: auto;
      display: block;
      padding: 3.5rem 0.5rem 4.5rem;
      opacity: 1;
      transform: none;
    }

    .aila-focus-story__panel-header {
      padding-right: 0;
    }

    .aila-focus-story__panel-header h2 {
      max-width: 16ch;
      font-size: clamp(2.2rem, 7vw, 3.8rem);
    }

    .aila-focus-story__panel-link {
      position: static;
      width: fit-content;
      margin-top: 1.25rem;
    }

    .aila-focus-story__products {
      margin-top: 2rem;
    }

    .aila-focus-story__product-card {
      opacity: 1;
      transform: none;
    }

    .aila-focus-story__product-media {
      height: auto;
      aspect-ratio: 1;
    }

    .aila-focus-story__progress {
      display: none;
    }
  }

  @media screen and (max-width: 599px) {
    .aila-focus-story__stage {
      padding-inline: 0.625rem;
    }

    .aila-focus-story__media-frame {
      min-height: 500px;
    }

    .aila-focus-story__hero-copy {
      right: 1.6rem;
      left: 1.6rem;
    }

    .aila-focus-story__hero-heading {
      font-size: clamp(2.65rem, 13vw, 4.4rem);
    }

    .aila-focus-story__products {
      grid-auto-columns: minmax(76vw, 1fr);
      grid-template-columns: none;
      grid-auto-flow: column;
      margin-right: -0.625rem;
      margin-left: -0.625rem;
      padding: 0 0.625rem 0.8rem;
      overflow-x: auto;
      scroll-padding-left: 0.625rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .aila-focus-story__products::-webkit-scrollbar {
      display: none;
    }

    .aila-focus-story__product-card {
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aila-focus-story__product-image,
    .aila-focus-story__product-placeholder,
    .aila-focus-story__panel-link,
    .aila-focus-story__product-arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Zooming product story",
  "tag": "div",
  "class": "section-wrapper seoul-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Hero media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Story video",
      "info": "Shopify-hosted video. It autoplays muted and loops."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Shown when no video is selected."
    },
    {
      "type": "range",
      "id": "media_position_x",
      "label": "Horizontal focal point",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "media_position_y",
      "label": "Vertical focal point",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Hero eyebrow",
      "default": "Aila in focus"
    },
    {
      "type": "inline_richtext",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Meet the scents behind the <em>story.</em>"
    },
    {
      "type": "richtext",
      "id": "hero_text",
      "label": "Hero text",
      "default": "<p>A closer look at fragrances worth lingering over.</p>"
    },
    {
      "type": "header",
      "content": "Product panel"
    },
    {
      "type": "text",
      "id": "panel_eyebrow",
      "label": "Panel eyebrow",
      "default": "The edit"
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Panel heading",
      "default": "Find your next signature."
    },
    {
      "type": "textarea",
      "id": "panel_text",
      "label": "Panel text",
      "default": "Explore the fragrances featured in the story, selected for their character and staying power."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Scroll effect"
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Desktop scroll length",
      "min": 240,
      "max": 480,
      "step": 20,
      "unit": "vh",
      "default": 340
    },
    {
      "type": "range",
      "id": "zoom_amount",
      "label": "Video zoom",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "%",
      "default": 18
    },
    {
      "type": "range",
      "id": "final_media_width",
      "label": "Final media width",
      "min": 40,
      "max": 58,
      "step": 2,
      "unit": "%",
      "default": 48
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Media corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
